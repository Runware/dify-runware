# Remote debugging against a running Dify instance.
# Get the address + key from Dify: Plugins page -> click the bug (debug) icon.
# Copy this file to .env and fill REMOTE_INSTALL_KEY, then run:  python -m main

INSTALL_METHOD=remote

# Dify Cloud:
REMOTE_INSTALL_URL=debug.dify.ai:5003

# Self-hosted (Docker) alternative — comment out REMOTE_INSTALL_URL above and use:
# REMOTE_INSTALL_HOST=localhost
# REMOTE_INSTALL_PORT=5003

# This key rotates often. If you see "handshake failed / invalid key", refresh it in the UI.
REMOTE_INSTALL_KEY=
